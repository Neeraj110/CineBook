{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "noImplicitAny": false,
    "useUnknownInCatchVariables": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
